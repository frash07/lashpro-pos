# Copy these names into Render's environment settings; never commit real secrets.
# Generate DJANGO_SECRET_KEY with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-unique-random-secret-key
DEBUG=false

# Render sets RENDER_EXTERNAL_HOSTNAME and RENDER_EXTERNAL_URL automatically.
# These explicit entries are useful for a custom domain or another host.
ALLOWED_HOSTS=lashpro-pos-alpha.onrender.com
CSRF_TRUSTED_ORIGINS=https://lashpro-pos-alpha.onrender.com

# Paste Neon's pooled connection string (hostname contains -pooler) and require TLS.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
DB_CONN_MAX_AGE=0
DB_DISABLE_SERVER_SIDE_CURSORS=true

SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=300
# Keep enabled only when every subdomain under the configured host uses HTTPS.
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# This sends a browser directive; do not submit the host to preload lists until stable.
SECURE_HSTS_PRELOAD=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
TRUST_PROXY_SSL_HEADER=true
AXES_IPWARE_PROXY_COUNT=1
LOG_LEVEL=INFO

# Set these only for the first deploy, then remove all three from Render.
# The password must meet the Django password validators.
# DJANGO_BOOTSTRAP_OWNER_USERNAME=owner
# DJANGO_BOOTSTRAP_OWNER_EMAIL=owner@example.com
# DJANGO_BOOTSTRAP_OWNER_PASSWORD=replace-with-a-unique-strong-password

# Local DB_* settings remain supported when DATABASE_URL is unset:
# DB_NAME=lashpro
# DB_USER=lashpro
# DB_PASSWORD=replace-with-database-secret
# DB_HOST=127.0.0.1
# DB_PORT=5432
