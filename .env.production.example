# LashPro POS production environment reference.
# Production secrets belong in Fly.io app secrets, NOT in Git or committed files.
# Copy each required value into: fly secrets set KEY='value' --app lashpro-pos
# Keep DJANGO_SECRET_KEY stable; IntegrationSettings credentials are encrypted with it.

DJANGO_ENV=production
DJANGO_SECRET_KEY=replace-with-a-unique-random-secret-key
DEBUG=false

# Current Fly app hostname. Add the business-owned POS hostname after it is registered.
ALLOWED_HOSTS=lashpro-pos.fly.dev
CSRF_TRUSTED_ORIGINS=https://lashpro-pos.fly.dev
POS_HOSTS=lashpro-pos.fly.dev
POS_BASE_URL=https://lashpro-pos.fly.dev

# Neon PostgreSQL: use the SAME project, branch, database and pooled endpoint
# for lashpro-pos and lashpro-storefront. Keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler:5432/DATABASE?sslmode=require
# Optional: POS-only direct/unpooled URL for release migrations, from the SAME
# Neon branch/database. Do not configure this on the storefront.
# DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require
DB_CONN_MAX_AGE=0
DB_DISABLE_SERVER_SIDE_CURSORS=true

# Fly's edge proxy terminates HTTPS and overwrites X-Forwarded-Proto.
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=300
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
TRUST_PROXY_SSL_HEADER=true
AXES_IPWARE_PROXY_COUNT=1
LOG_LEVEL=INFO

# Required for product/service ImageField uploads unless S3-compatible storage
# is configured instead. Full value is a secret, never commit it.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# The separate storefront app needs CLOUDINARY_CLOUD_NAME only (public name).
# Do not put Cloudinary API credentials in the storefront app.
# CLOUDINARY_CLOUD_NAME=CLOUD_NAME

# SMTP is required for staff email password recovery and transactional email.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-username
EMAIL_HOST_PASSWORD=replace-with-smtp-app-password
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL="LashPro <no-reply@example.com>"

# Only set these for the first deployment. Remove them after owner login is verified.
# DJANGO_BOOTSTRAP_OWNER_USERNAME=owner
# DJANGO_BOOTSTRAP_OWNER_EMAIL=owner@example.com
# DJANGO_BOOTSTRAP_OWNER_PASSWORD=replace-with-a-unique-strong-password

# Always false on the production database. Synthetic data belongs on a disposable DB.
SYNTHETIC_DATA_ENABLED=false

# Public booking/order holds (minutes)
PUBLIC_ORDER_RESERVATION_MINUTES=30
PUBLIC_BOOKING_HOLD_MINUTES=30

# Optional S3-compatible storage alternative to Cloudinary:
# BUCKET_NAME=your-bucket
# AWS_ENDPOINT_URL_S3=https://your-s3-endpoint
# AWS_REGION=auto
# AWS_ACCESS_KEY_ID=replace-with-access-key
# AWS_SECRET_ACCESS_KEY=replace-with-secret-key
# MEDIA_PUBLIC_DOMAIN=your-public-media-domain
